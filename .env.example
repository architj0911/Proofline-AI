# Server Configuration
PORT=3001
NODE_ENV=development

# AI Provider Selection: 'gemini' (primary with openrouter fallback) | 'openrouter' | 'groq' | 'mock'
AI_PROVIDER=gemini
USE_MOCK_AI=false

# Google Gemini AI Configuration (Primary provider - Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter AI Configuration (Fallback backup provider - Server-side only)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Groq AI Configuration (Optional provider - Server-side only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Supabase Authentication & Persistence (Frontend - Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
